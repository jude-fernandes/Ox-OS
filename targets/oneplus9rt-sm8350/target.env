OX_TARGET=oneplus9rt-sm8350
OX_SOC='Qualcomm SM8350 (Snapdragon 888)'
OX_BOOT_HEADER_VERSION=2
OX_BOOT_PAGESIZE=4096
OX_BOOT_BASE=0x10000000
OX_BOOT_KERNEL_OFFSET=0x00080000
OX_BOOT_RAMDISK_OFFSET=0x01000000
OX_BOOT_TAGS_OFFSET=0x00000100
OX_BOOT_DTB_OFFSET=0x01F00000
OX_CMDLINE='console=ttyMSM0,115200n8 printk.devkmsg=on quiet'
