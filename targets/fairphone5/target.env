OX_TARGET=fairphone5
OX_SOC='Qualcomm QCM6490 (SM7325 family)'
OX_BOOT_HEADER_VERSION=4
OX_BOOT_PAGESIZE=4096
# v3+ headers carry no load addresses (the bootloader places the image);
# offsets below are recorded for the vendor_boot path only.
OX_BOOT_BASE=0x00000000
OX_BOOT_KERNEL_OFFSET=0x00080000
OX_BOOT_RAMDISK_OFFSET=0x01000000
OX_BOOT_TAGS_OFFSET=0x00000100
OX_BOOT_DTB_OFFSET=0x01F00000
# mainline QCM6490 console = GENI UART (ttyMSM0)
OX_CMDLINE='console=ttyMSM0,115200n8 printk.devkmsg=on ro rootwait'
# AVB: the FP5 ABL reads the vbmeta partition and follows hash/chain
# descriptors to boot/dtbo (BRINGUP.md). Dev key until owner enrollment.
OX_AVB_ALGORITHM=SHA256_RSA4096
OX_AVB_BOOT_PARTITION_SIZE=67108864
OX_AVB_DTBO_PARTITION_SIZE=8388608
