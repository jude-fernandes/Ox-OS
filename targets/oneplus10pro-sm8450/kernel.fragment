# Ox OS kernel fragment: Qualcomm mobile SoC base (android-boot targets)
# Start from the qemu-virt fragment, then add this. Trim after M2 review.
CONFIG_ARCH_QCOM=y
CONFIG_ARM_QCOM_CPUFREQ_NVMEM=y
CONFIG_QCOM_CPR=y
CONFIG_QCOM_PDR_HELPERS=y
CONFIG_QCOM_QMI_HELPERS=y
CONFIG_QCOM_RMTFS_MEM=y
CONFIG_QCOM_RPROC_COMMON=y
CONFIG_QCOM_SMSM=y
CONFIG_QCOM_SOCINFO=y
CONFIG_QCOM_SPMI_ADC5=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y
CONFIG_QCOM_WCNSS_CTRL=y
# remoteproc: modem / WiFi / DSP
CONFIG_QCOM_PIL_INFO=y
CONFIG_QCOM_Q6V5_COMMON=y
CONFIG_QCOM_Q6V5_MSS=y
CONFIG_QCOM_Q6V5_ADSP=y
CONFIG_QCOM_Q6V5_WCSS=y
CONFIG_QCOM_SYSMON=y
# interconnect / regulators / pinctrl (per-SoC drivers added on top)
CONFIG_INTERCONNECT=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_REGULATOR_QCOM_SMD_RPM=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
# storage / usb
CONFIG_MMC_SDHCI_MSM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_TYPEC=m
CONFIG_TYPEC_UCSI=m
# connectivity (SoC-dependent: ath11k for WCN6855-class, wcnss for older)
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
CONFIG_BT_QCA=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_QCA=y
# input: enable all common phone touch controllers until device-specific trim
CONFIG_TOUCHSCREEN_ATMEL_MXT=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX=y
CONFIG_TOUCHSCREEN_FTS=y
CONFIG_INPUT_GPIO_VIBRA=y
# display: DSI panel infra; specific panels are DT work at bring-up
CONFIG_DRM_MSM=y
CONFIG_DRM_PANEL_SIMPLE=y
CONFIG_DRM_PANEL_NOVATEK_NT36672A=y
CONFIG_DRM_PANEL_SAMSUNG_SOFEF00=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
# misc phone
CONFIG_CHARGER_QCOM_SMBB=y
CONFIG_QCOM_LABIBB=y
CONFIG_NFC_NCI=y
CONFIG_NFC_NXP_NCI=y
