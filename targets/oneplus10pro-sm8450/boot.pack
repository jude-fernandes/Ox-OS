#!/usr/bin/env bash
# OnePlus 10 Pro (SM8450): package the Ox payload for the Android chain.
# Header v4 with vendor_boot (the FDT rides vendor_boot per target.env).
# Produces: boot.img + vendor_boot.img (AVB hash footers) + vbmeta.img
# (chain root) + avb-pkmd.bin (the re-lock enrollment value).
# usage: boot.pack <Image> <initramfs.cpio.gz> <dtb> [outdir]
set -eu
SELF="$(cd "$(dirname "$0")" && pwd)"
. "$SELF/target.env"
MKBOOT="$SELF/../../tools/ox-mkbootimg.py"
AVB="$SELF/../../tools/aosp/avbtool.py"
KEY="${OX_AVB_KEY:-$SELF/../../tools/dev-keys/avb-dev.pem}"
K="$1"; R="$2"; D="$3"; OUT="${4:-.}"
mkdir -p "$OUT"
for f in "$KEY" "$K" "$R" "$D"; do
    [ -f "$f" ] || { echo "FATAL: missing $f" >&2; exit 4; }
done

# 1) boot image v4 + vendor_boot v4 (dtb); kernel gzipped (ABL expands)
gzip -9c "$K" > "$OUT/.kernel.gz"
python3 "$MKBOOT" --kernel "$OUT/.kernel.gz" --ramdisk "$R" \
    --pagesize "$OX_BOOT_PAGESIZE" \
    --cmdline "$OX_CMDLINE" --header-version "$OX_BOOT_HEADER_VERSION" \
    --vendor-boot "$OUT/vendor_boot.img" --dtb "$D" \
    -o "$OUT/boot.img"
rm -f "$OUT/.kernel.gz"
python3 "$MKBOOT" --verify --output "$OUT/boot.img"
python3 "$MKBOOT" --verify --output "$OUT/vendor_boot.img"

# 2) AVB: hash footers under the dev key + the vbmeta chain root
BOOT_PART=67108864    # boot_a 64M (BRINGUP)
VB_PART=67108864      # vendor_boot_a 64M
python3 "$AVB" add_hash_footer --image "$OUT/boot.img" \
    --partition_name boot --partition_size "$BOOT_PART" \
    --key "$KEY" --algorithm SHA256_RSA4096
python3 "$AVB" add_hash_footer --image "$OUT/vendor_boot.img" \
    --partition_name vendor_boot --partition_size "$VB_PART" \
    --key "$KEY" --algorithm SHA256_RSA4096
python3 "$AVB" extract_public_key --key "$KEY" --output "$OUT/avb-boot.pk"
python3 "$AVB" make_vbmeta_image \
    --chain_partition "boot:1:$OUT/avb-boot.pk" \
    --key "$KEY" --algorithm SHA256_RSA4096 \
    --output "$OUT/vbmeta.img"
sha256sum "$OUT/avb-boot.pk" | cut -d' ' -f1 > "$OUT/avb-pkmd.bin"

echo "artifacts in $OUT: boot.img vendor_boot.img vbmeta.img avb-pkmd.bin"
echo "flash: fastboot flash boot $OUT/boot.img"
echo "       fastboot flash vendor_boot $OUT/vendor_boot.img"
echo "       fastboot flash vbmeta $OUT/vbmeta.img"
