#!/bin/sh
# telephony-app-selftest longrun: the Dialer app's on-device lifecycle.
# 1. install the signed dialer.oxp package (dynamic tile, telephony.dial
#    bound deny by the manifest-permission rule)
# 2. wait for the app to dial and be REFUSED (bound deny)
# 3. flip the user grant -> the next dial goes to the radio for real
{
    i=0
    while [ ! -S /run/ox/sockets/intentd.sock ] || [ ! -S /run/ox/sockets/permstored.sock ]; do
        [ $i -ge 120 ] && break
        sleep 1; i=$((i + 1))
    done
    if [ ! -S /run/ox/sockets/intentd.sock ] || [ ! -S /run/ox/sockets/permstored.sock ]; then
        echo "OXMILESTONE name=dialer-app-install-failed reason=no-sockets"
        exec sleep infinity
    fi

    I=$(/usr/bin/oxpkg install /usr/share/ox/packages/dialer.oxp 2>&1)
    echo "DBG-DIALER-INSTALL $I"
    case "$I" in
        *ok*) echo "OXMILESTONE name=dialer-app-installed" ;;
        *) echo "OXMILESTONE name=dialer-app-install-failed"; exec sleep infinity ;;
    esac

    # the gate dials from the pad; wait until the bound deny refused it.
    # Chunk 68 hardening: 450x2s (the Oct-5 mt-call boot's gate tapped
    # LATE — the old 600s window expired first and the flip raced the
    # gate's wait), plus expiry/observe DBG lines so a silent gap
    # localizes itself next time.
    i=0
    while [ $i -lt 450 ]; do
        /bin/dmesg 2>/dev/null | grep -q "name=dialer-call-denied" && break
        sleep 2; i=$((i + 1))
    done
    if [ $i -ge 450 ]; then
        echo "DBG-DIALER-WAIT-EXPIRED i=$i"
    else
        echo "DBG-DIALER-DENIAL-OBSERVED i=$i"
    fi
    G=$(/usr/bin/oxctl permstored set '{"app":"ox-dialer","permission":"telephony.dial","mode":"grant"}' 2>&1)
    echo "DBG-DIALER-GRANT $G"
    echo "OXMILESTONE name=dialer-app-granted"
    exec sleep infinity
} > /dev/console 2>&1
