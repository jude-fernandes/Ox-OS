#!/bin/sh
# lockd-selftest longrun (chunk 58): transport secret hygiene, proven
# in the running guest. A decoy secret rides the real socket to lockd;
# the selftest-scrub op scrubs its copy and journals the byte-level
# result (OXMILESTONE name=ipc-scrub). lockd itself is the witness —
# the decoy never exists outside this guest.
{
    echo "DBG-LOCKD-SELFTEST-START pid=$$"
    i=0
    while [ ! -S /run/ox/sockets/lockd.sock ]; do
        [ $i -ge 120 ] && break
        sleep 1; i=$((i + 1))
    done
    if [ ! -S /run/ox/sockets/lockd.sock ]; then
        echo "OXMILESTONE name=lockd-selftest-failed reason=no-socket"
        exec sleep infinity
    fi
    R=$(/usr/bin/oxctl lockd selftest-scrub '{"decoy":"ox-scrub-decoy-1234"}' 2>&1)
    echo "DBG-LOCKD-SELFTEST-RESP $R"
    case "$R" in
        *'"clean":true'*) : ;;
        *) echo "OXMILESTONE name=lockd-selftest-failed reason=scrub"; exec sleep infinity ;;
    esac
    echo "DBG-LOCKD-SELFTEST-DONE"
    exec sleep infinity
} > /dev/console 2>&1
