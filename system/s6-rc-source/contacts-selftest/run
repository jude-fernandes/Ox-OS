#!/bin/sh
# contacts-selftest longrun: the honest-permission lifecycle against
# contactsd for app "contacts.test":
#   deny  -> list refused
#   fake  -> synthetic contacts served (synthetic:true)
#   grant -> real store served (empty on a fresh device)
# Then restore deny (least privilege).
{
    sleep 8
    i=0
    while [ ! -S /run/ox/sockets/contactsd.sock ] || [ ! -S /run/ox/sockets/permstored.sock ]; do
        [ $i -ge 120 ] && break
        sleep 1; i=$((i + 1))
    done
    if [ ! -S /run/ox/sockets/contactsd.sock ] || [ ! -S /run/ox/sockets/permstored.sock ]; then
        echo "OXMILESTONE name=contacts-test-failed"
        exec sleep infinity
    fi
    FAIL=no
    /usr/bin/oxctl permstored set '{"app":"oxctl","permission":"contacts.read","mode":"deny"}' >/dev/null 2>&1
    D=$(/usr/bin/oxctl contactsd list '{"app":"oxctl"}' 2>&1)
    echo "DBG-CT-DENY $D"
    case "$D" in *denied*|*DENIED*) ;; *) FAIL=yes ;; esac
    /usr/bin/oxctl permstored set '{"app":"oxctl","permission":"contacts.read","mode":"fake"}' >/dev/null 2>&1
    F=$(/usr/bin/oxctl contactsd list '{"app":"oxctl"}' 2>&1)
    echo "DBG-CT-FAKE $F"
    case "$F" in *'"synthetic":true'*) ;; *) FAIL=yes ;; esac
    /usr/bin/oxctl permstored set '{"app":"oxctl","permission":"contacts.read","mode":"grant"}' >/dev/null 2>&1
    G=$(/usr/bin/oxctl contactsd list '{"app":"oxctl"}' 2>&1)
    echo "DBG-CT-GRANT $G"
    case "$G" in *'"synthetic":false'*) ;; *) FAIL=yes ;; esac
    /usr/bin/oxctl permstored set '{"app":"oxctl","permission":"contacts.read","mode":"deny"}' >/dev/null 2>&1
    if [ "$FAIL" = no ]; then
        echo "OXMILESTONE name=contacts-test-ok"
    else
        echo "OXMILESTONE name=contacts-test-failed"
    fi
    exec sleep infinity
} > /dev/console 2>&1
