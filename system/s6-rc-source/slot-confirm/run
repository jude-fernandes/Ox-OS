#!/bin/sh
# chunk 77: confirm this boot for the ACTIVE A/B slot. Order (after
# boot-health) is enforced by the s6-rc graph; under the R-21 fallback
# the ordering is best-effort. Longrun because R-21 oneshots cannot run
# under plain s6-svscan. oxctl refuses a second confirm (attempts==0)
# so s6 restarts are harmless.
exec > /dev/console 2>&1
/usr/bin/oxctl slot-confirm
exec sleep infinity
