#!/bin/sh
# notifd-selftest longrun: the notification + permission flow.
# 1. grant post-notification to test.app (permstored)
# 2. post as test.app -> accepted
# 3. list contains the notification
# 4. post as stranger.app -> refused (no grant; fail closed)
# 5. set a fake-data mode -> accepted by the store
# Idempotent; safe to run every boot.
{
    sleep 8
    i=0
    while [ ! -S /run/ox/sockets/notifd.sock ] || [ ! -S /run/ox/sockets/permstored.sock ]; do
        [ $i -ge 120 ] && break
        sleep 1; i=$((i + 1))
    done
    if [ ! -S /run/ox/sockets/notifd.sock ] || [ ! -S /run/ox/sockets/permstored.sock ]; then
        echo "OXMILESTONE name=notifd-flow-failed"
        echo "<6>notifd: OXMILESTONE name=notifd-flow-failed" > /dev/kmsg
        exec sleep infinity
    fi
    FAIL=no
    G=$(/usr/bin/oxctl permstored set '{"app":"oxctl","permission":"post-notification","mode":"grant"}' 2>&1)
    echo "DBG-PERM $G"
    case "$G" in *'"mode":"grant"'*) ;; *) FAIL=yes ;; esac
    P=$(/usr/bin/oxctl notifd post '{"app":"test.app","title":"drill-title","body":"drill body"}' 2>&1)
    echo "DBG-POST $P"
    case "$P" in *'"id":'*) ;; *) FAIL=yes ;; esac
    L=$(/usr/bin/oxctl notifd list 2>&1)
    echo "DBG-LIST $L"
    case "$L" in *drill-title*) ;; *) FAIL=yes ;; esac
    D=$(/usr/bin/oxctl notifd post '{"app":"stranger.app","title":"x","body":"y"}' 2>&1)
    echo "DBG-DENY $D"
    case "$D" in *denied*|*DENIED*) ;; *) FAIL=yes ;; esac
    F=$(/usr/bin/oxctl permstored set '{"app":"test.app","permission":"contacts.read","mode":"fake"}' 2>&1)
    echo "DBG-FAKE $F"
    case "$F" in *'"mode":"fake"'*) ;; *) FAIL=yes ;; esac
    if [ "$FAIL" = no ]; then
        echo "OXMILESTONE name=notifd-flow-ok"
        echo "<6>notifd: OXMILESTONE name=notifd-flow-ok" > /dev/kmsg
    else
        echo "OXMILESTONE name=notifd-flow-failed"
        echo "<6>notifd: OXMILESTONE name=notifd-flow-failed" > /dev/kmsg
    fi
    exec sleep infinity
} > /dev/console 2>&1
