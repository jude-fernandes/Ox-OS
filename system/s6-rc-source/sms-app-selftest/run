#!/bin/sh
# sms-app-selftest longrun: the Messaging app's on-device lifecycle.
# 1. install the signed sms.oxp package (dynamic tile, telephony.sms
#    bound deny by the manifest-permission rule)
# 2. wait for the app to send and be REFUSED (bound deny)
# 3. flip the user grant -> the next send goes to the radio for real
{
    i=0
    while [ ! -S /run/ox/sockets/intentd.sock ] || [ ! -S /run/ox/sockets/permstored.sock ]; do
        [ $i -ge 120 ] && break
        sleep 1; i=$((i + 1))
    done
    if [ ! -S /run/ox/sockets/intentd.sock ] || [ ! -S /run/ox/sockets/permstored.sock ]; then
        echo "OXMILESTONE name=sms-app-install-failed reason=no-sockets"
        exec sleep infinity
    fi

    I=$(/usr/bin/oxpkg install /usr/share/ox/packages/sms.oxp 2>&1)
    echo "DBG-SMS-INSTALL $I"
    case "$I" in
        *ok*) echo "OXMILESTONE name=sms-app-installed" ;;
        *) echo "OXMILESTONE name=sms-app-install-failed"; exec sleep infinity ;;
    esac

    # the gate composes +15550001 "hi" and taps Send; wait until the
    # bound deny refused it
    i=0
    while [ $i -lt 300 ]; do
        /bin/dmesg 2>/dev/null | grep -q "name=sms-send-denied" && break
        sleep 2; i=$((i + 1))
    done
    G=$(/usr/bin/oxctl permstored set '{"app":"ox-sms","permission":"telephony.sms","mode":"grant"}' 2>&1)
    echo "DBG-SMS-GRANT $G"
    echo "OXMILESTONE name=sms-app-granted"
    exec sleep infinity
} > /dev/console 2>&1
