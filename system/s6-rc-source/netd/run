#!/bin/sh
# netd longrun: network service — interface bring-up (slirp defaults on
# the virtual target), local DNS forwarder on 127.0.0.1:53 with the
# egress journal, and name policy. The upstream is the host loopback
# alias (10.0.2.2) so the gate's deterministic DNS server answers;
# unset, netd falls back to slirp's resolver (10.0.2.3).
OX_DNS_UPSTREAM=10.0.2.2:53
export OX_DNS_UPSTREAM
exec /usr/bin/oxnetd
