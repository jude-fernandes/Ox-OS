# Ox OS kernel fragment — OnePlus Android-chain targets (SM8350/SM8450).
# The .config source-of-truth mirror of kernel/kernel-oneplus-qcom.nix
# (one shared builder serves both SoCs; the boot essentials are the
# same Qualcomm mobile set). Deliberately OUT, per the chunk-73/74
# scoping: display (MSM DRM =m-capped select closure — M-gate scope),
# radios (ath11k/BT_QCA), charging, NFC, touch controllers — their own
# hardware gates land them; the phase-1 targets/*/kernel.fragment
# files remain the design record for that scope. The boot contract is
# the GENI serial console.
#
# shared posture:
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_SCHED_AUTOGROUP=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y
CONFIG_PSI=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_DM_VERITY=y
CONFIG_DM_CRYPT=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_NONE=y
CONFIG_SECURITY=y
CONFIG_SECURITY_YAMA=y
CONFIG_IO_URING=n
CONFIG_DEVMEM=n
CONFIG_COMPAT_BRK=n
CONFIG_RUST=n
CONFIG_PRINTK_TIME=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_AES_ARM64=y
CONFIG_CRYPTO_AES_ARM64_CE=y
CONFIG_CRYPTO_AES_ARM64_CE_BLK=y
CONFIG_CRYPTO_AES_ARM64_CE_BS=y

# Qualcomm mobile boot essentials:
CONFIG_ARCH_QCOM=y
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_I2C=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_STORAGE=y
CONFIG_QRTR=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_PM8XXX=y
CONFIG_REGULATOR=y
CONFIG_POWER_SUPPLY=y
