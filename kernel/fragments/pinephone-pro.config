# Ox OS kernel fragment — PinePhone Pro (RK3399).
# The .config source-of-truth mirror of kernel/kernel-pinephone-pro.nix.
# Scope discipline (chunk 72): BOOT essentials only — serial, eMMC/SD,
# display+touch, USB/modem-bus, PMIC/RTC — plus the SAME storage,
# integrity and security posture the verified system slot requires
# (dm-verity/erofs/dm-crypt/AES-CE are the rootfs contract). Radios,
# camera and audio drivers land WITH their own hardware gates (M3+),
# not here — no unproven scope.
#
# base-mobile + security/storage posture (shared with qemu-virt):
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_SCHED_AUTOGROUP=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y
CONFIG_PSI=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_DM_VERITY=y
CONFIG_DM_CRYPT=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_NONE=y
CONFIG_SECURITY=y
CONFIG_SECURITY_YAMA=y
CONFIG_IO_URING=n
CONFIG_DEVMEM=n
CONFIG_COMPAT_BRK=n
CONFIG_RUST=n
CONFIG_PRINTK_TIME=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_AES_ARM64=y
CONFIG_CRYPTO_AES_ARM64_CE=y
CONFIG_CRYPTO_AES_ARM64_CE_BLK=y
CONFIG_CRYPTO_AES_ARM64_CE_BS=y

# PinePhone Pro board essentials:
CONFIG_ARCH_ROCKCHIP=y
# console (rk3399 UART = 8250 DesignWare, ttyS2)
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
# eMMC (sdhci-arasan) + SD/SDIO (dw_mmc-rockchip)
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_OF_ARASAN=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
# display: Rockchip DRM + MIPI-DSI + the XBD599 panel
CONFIG_DRM=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_DRM_MIPI_DSI=y
CONFIG_ROCKCHIP_DW_MIPI_DSI=y
CONFIG_DRM_PANEL=y
CONFIG_DRM_PANEL_XINGBANGDA_XBD599=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONT_SUPPORT=y
CONFIG_FONT_8x16=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
# touch + input (Goodix over I2C) + GPIO keys
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_TOUCHSCREEN_GOODIX=y
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_RK3X=y
CONFIG_KEYBOARD_GPIO=y
# USB: DWC3 + type-C (FUSB302) + the modem bus (EG25: QMI + AT serial)
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_OF_SIMPLE=y
CONFIG_USB_STORAGE=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_QMI_WWAN=y
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_OPTION=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_TYPEC=y
# FUSB302 hangs off the Type-C Port Controller Manager: the kconfig
# merge demotes FUSB302 if TCPM is unset and dies on the repeated
# question (the 2026-10-05 config-log finding) — pin the chain.
CONFIG_TYPEC_TCPM=y
CONFIG_TYPEC_FUSB302=y
CONFIG_GENERIC_PHY=y
CONFIG_PHY_ROCKCHIP_INNO_USB2=y
# PMIC (RK818) + clock/battery scaffolding + RTC
CONFIG_MFD_RK8XX=y
CONFIG_MFD_RK8XX_I2C=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_RK808=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_RK808=y
CONFIG_POWER_SUPPLY=y
CONFIG_CHARGER_RK818=y
